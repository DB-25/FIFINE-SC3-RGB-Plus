<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowColor">#000000</Color>
    <Color x:Key="PanelColor">#090909</Color>
    <Color x:Key="PanelAltColor">#0D0D0D</Color>
    <Color x:Key="InputColor">#080808</Color>
    <Color x:Key="HoverColor">#121212</Color>
    <Color x:Key="TextColor">#F5F5F5</Color>
    <Color x:Key="SecondaryTextColor">#A0A0A0</Color>
    <!-- #8A8A8A keeps small hint text at ~5.8:1 on the panels (was #676767, ~3.5:1). -->
    <Color x:Key="MutedColor">#8A8A8A</Color>
    <Color x:Key="BorderColor">#242424</Color>
    <Color x:Key="AccentColor">#FF7800</Color>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <!-- Updated with AccentBrush at runtime: content on the accent, and the accent as readable text/outline on dark panels. -->
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ConnectedBrush" Color="#4EE978" />
    <SolidColorBrush x:Key="DisconnectedBrush" Color="#FF4D5E" />
</ResourceDictionary>
